rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      function isValidUser(data) {
        return data.userId == request.auth.uid 
          && data.level is number && data.level >= 1
          && data.experience is number
          && data.buildPower is number
          && data.containers is number
          && data.data is number;
      }

      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) 
        && isValidUser(request.resource.data)
        && request.resource.data.userId == resource.data.userId;
    }

    // --- Buildings ---
    match /users/{userId}/buildings/{buildingId} {
      allow read: if isSignedIn();
      
      function isValidBuilding(data) {
        return data.ownerId == request.auth.uid
          && data.type in ['townhall', 'git_base', 'jenkins_lab', 'docker_yard', 'web_server', 'storage_vault']
          && data.level is number && data.level >= 1
          && data.gridX is number && data.gridX >= 0 && data.gridX < 12
          && data.gridY is number && data.gridY >= 0 && data.gridY < 12
          && (!('skin' in data) || data.skin in ['classic', 'industrial', 'futuristic', 'retro']);
      }

      allow create: if isOwner(userId) && isValidBuilding(request.resource.data);
      allow update: if isOwner(userId) 
        && isValidBuilding(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(userId);
    }
  }
}
